{
  "name": "@calllint/usage-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Private telemetry ingress for CallLint — a dedicated Cloudflare Worker. Aggregate-only, no raw event log.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@calllint/telemetry-contract": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "wrangler": "4.86.0"
  }
}
