{
  "$schema": "https://calllint.com/schemas/agent-surfaces.v1.json",
  "version": "1.0.0",
  "describes": {
    "release": "1.8.0"
  },
  "description": "Machine-readable agent harness authority surfaces and CallLint support",
  "canonicalIndex": "https://calllint.com/agent-discovery-index.json",
  "mcp": {
    "registry": "io.github.calllint/calllint",
    "package": "calllint-mcp",
    "state": "LIVE"
  },
  "agents": [
    {
      "id": "claude-code",
      "displayName": "Claude Code",
      "vendor": "Anthropic",
      "priority": "P0",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "filesystem",
        "shell",
        "plugins"
      ],
      "configPaths": [
        "~/.claude/settings.json",
        "<project>/.claude/settings.json"
      ],
      "scanCommands": [
        "calllint scan --agent claude-code"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/claude-code",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AVAILABLE",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "claude-plugin",
          "state": "AVAILABLE",
          "officialSource": "https://code.claude.com/docs/en/plugin-marketplaces"
        }
      ],
      "coverageBoundary": "CallLint scans MCP server entries only. Skills, hooks and permission settings in the same file are not covered."
    },
    {
      "id": "claude-desktop",
      "displayName": "Claude Desktop",
      "vendor": "Anthropic",
      "priority": "P0",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "filesystem"
      ],
      "configPaths": [
        "~/Library/Application Support/Claude/claude_desktop_config.json",
        "%APPDATA%/Claude/claude_desktop_config.json"
      ],
      "scanCommands": [
        "calllint scan --agent claude-desktop"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/claude-desktop",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AVAILABLE",
          "upstream": "officialMcpRegistry"
        }
      ],
      "coverageBoundary": "CallLint scans MCP server entries only. Other Claude Desktop settings in the same file are not covered."
    },
    {
      "id": "cursor",
      "displayName": "Cursor",
      "vendor": "Anysphere",
      "priority": "P0",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "filesystem",
        "shell"
      ],
      "configPaths": [
        "~/.cursor/mcp.json",
        "<project>/.cursor/mcp.json"
      ],
      "scanCommands": [
        "calllint scan --agent cursor"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/cursor",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "cursor-plugin",
          "state": "PENDING_UPSTREAM",
          "officialSource": "https://cursor.com/marketplace"
        }
      ],
      "coverageBoundary": "CallLint scans MCP server entries only. Cursor rules and editor settings are not covered. Cloud Agents, background agents and event or timer wakeups (GitHub, Slack, Linear, cron) are not statically observable at all: what starts such an agent is decided in Cursor's cloud, not in a file on disk, so CallLint reports that authority as UNSUPPORTED rather than reading it as SAFE."
    },
    {
      "id": "vscode",
      "displayName": "VS Code",
      "vendor": "Microsoft",
      "priority": "P1",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "extensions",
        "mcp"
      ],
      "configPaths": [
        "~/.vscode/mcp.json",
        "<project>/.vscode/mcp.json"
      ],
      "scanCommands": [
        "calllint scan --agent vscode"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/vscode",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        }
      ],
      "coverageBoundary": "CallLint scans MCP server entries only. VS Code extensions and workspace settings are not covered."
    },
    {
      "id": "windsurf",
      "displayName": "Windsurf",
      "vendor": "Codeium",
      "priority": "P1",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "filesystem"
      ],
      "configPaths": [
        "~/.windsurf/mcp.json",
        "<project>/.windsurf/mcp.json"
      ],
      "scanCommands": [
        "calllint scan --agent windsurf"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/windsurf",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "windsurf-mcp-marketplace",
          "state": "BLOCKED",
          "officialSource": "https://docs.devin.ai/desktop/cascade/mcp"
        }
      ],
      "coverageBoundary": "CallLint scans MCP server entries only. Windsurf rules and workflow settings are not covered."
    },
    {
      "id": "workbuddy",
      "displayName": "WorkBuddy",
      "vendor": "Tencent Cloud",
      "priority": "P0",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "extensions"
      ],
      "configPaths": [
        "~/.workbuddy/mcp.json",
        "<project>/.workbuddy/mcp.json"
      ],
      "scanCommands": [
        "calllint scan --agent workbuddy"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/workbuddy",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "tencent-mcp-market",
          "state": "BLOCKED",
          "officialSource": "https://cloud.tencent.com/document/product/1729"
        }
      ],
      "coverageBoundary": "CallLint scans MCP server entries only. Other WorkBuddy settings in the same file are not covered."
    },
    {
      "id": "qwen-code",
      "displayName": "Qwen Code",
      "vendor": "Alibaba Cloud",
      "priority": "P1",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "tools"
      ],
      "configPaths": [
        "~/.qwen/settings.json",
        "<project>/.qwen/settings.json"
      ],
      "scanCommands": [
        "calllint scan --agent qwen-code"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/qwen-code",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "qwen-extension-conversion",
          "state": "BLOCKED",
          "officialSource": "https://qwenlm.github.io/qwen-code-docs/en/users/extension/introduction/"
        }
      ],
      "coverageBoundary": "CallLint scans MCP server entries only. Other Qwen Code settings in the same file are not covered."
    },
    {
      "id": "openclaw",
      "displayName": "OpenClaw",
      "vendor": "Open Source",
      "priority": "P3",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "skills",
        "exec"
      ],
      "configPaths": [
        "~/.openclaw/openclaw.json"
      ],
      "scanCommands": [
        "calllint scan --agent openclaw"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/openclaw",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "openclaw-clawhub",
          "state": "BLOCKED",
          "officialSource": "https://docs.openclaw.ai/clawhub"
        }
      ],
      "coverageBoundary": "CallLint scans MCP configuration only. Skills and exec permissions are not covered."
    },
    {
      "id": "codex",
      "displayName": "OpenAI Codex",
      "vendor": "OpenAI",
      "priority": "P2",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "tools",
        "filesystem",
        "shell",
        "plugins"
      ],
      "configPaths": [
        "~/.codex/config.toml",
        "<project>/.codex/config.toml"
      ],
      "scanCommands": [
        "calllint scan --agent codex"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/codex",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "openai-plugin",
          "state": "BLOCKED"
        }
      ],
      "coverageBoundary": "CallLint reads the mcp_servers table from Codex TOML config. Other Codex settings in the same file are not interpreted."
    },
    {
      "id": "copilot-cli",
      "displayName": "GitHub Copilot CLI",
      "vendor": "GitHub",
      "priority": "P2",
      "supportClass": "DISCOVERY_ONLY",
      "authoritySurfaces": [
        "shell",
        "cli",
        "mcp"
      ],
      "configPaths": [
        "~/.copilot/mcp-config.json",
        ".mcp.json",
        ".github/mcp.json"
      ],
      "scanCommands": [],
      "canonicalUrl": "https://calllint.com/harnesses/copilot-cli",
      "distributionPrimitives": [
        {
          "kind": "mcp-registry-discovery",
          "state": "BLOCKED"
        },
        {
          "kind": "github-copilot-plugin",
          "state": "READY_NOT_SUBMITTED",
          "officialSource": "https://docs.github.com/copilot/how-tos/copilot-cli/customize-copilot/plugins-marketplace"
        }
      ],
      "coverageBoundary": "CallLint does not yet auto-discover Copilot CLI configuration."
    },
    {
      "id": "cline",
      "displayName": "Cline",
      "vendor": "Open Source",
      "priority": "P2",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "vscode-extensions",
        "cli",
        "tools",
        "mcp"
      ],
      "configPaths": [
        "~/.cline/data/settings/cline_mcp_settings.json",
        "$CLINE_DATA_DIR/settings/cline_mcp_settings.json",
        "<appData>/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json"
      ],
      "scanCommands": [
        "calllint scan --agent cline"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/cline",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AVAILABLE",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "cline-marketplace-pr",
          "state": "PENDING_UPSTREAM"
        }
      ],
      "coverageBoundary": "CallLint auto-discovers both Cline config files: the CLI's (~/.cline/data/settings/, relocatable via CLINE_DATA_DIR) and the VS Code extension's, which lives in per-extension globalStorage and is documented by no upstream page. Neither Cline's rules, hooks, skills, agents nor plugins directories are read, and ~/Documents/Cline/MCP/ holds installed server source rather than server registrations, so it is not a config path."
    },
    {
      "id": "gemini-cli",
      "displayName": "Gemini CLI",
      "vendor": "Google",
      "priority": "P2",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "tools"
      ],
      "configPaths": [
        "~/.gemini/settings.json",
        "<project>/.gemini/settings.json"
      ],
      "scanCommands": [
        "calllint scan --agent gemini-cli"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/gemini-cli",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "gemini-extension-gallery",
          "state": "AUDIT_REQUIRED",
          "officialSource": "https://geminicli.com/docs/extensions/"
        }
      ],
      "coverageBoundary": "CallLint scans the mcpServers map in Gemini CLI settings. OAuth token and server-enablement files are read for neither discovery nor verdicts."
    },
    {
      "id": "codebuddy",
      "displayName": "CodeBuddy",
      "vendor": "Tencent",
      "priority": "P2",
      "supportClass": "DEFERRED",
      "authoritySurfaces": [
        "mcp",
        "extensions"
      ],
      "configPaths": [
        "Config path requires verification"
      ],
      "scanCommands": [],
      "canonicalUrl": "https://calllint.com/harnesses/codebuddy",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "tencent-mcp-market",
          "state": "BLOCKED"
        }
      ],
      "coverageBoundary": "CallLint does not yet support CodeBuddy native discovery."
    },
    {
      "id": "opencode",
      "displayName": "OpenCode",
      "vendor": "Open Source",
      "priority": "P3",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "tools"
      ],
      "configPaths": [
        "~/.config/opencode/opencode.json",
        "<project>/opencode.json",
        "<project>/opencode.jsonc"
      ],
      "scanCommands": [
        "calllint scan --agent opencode"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/opencode",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        }
      ],
      "coverageBoundary": "CallLint scans local and remote servers under the root mcp key. {env:VAR} placeholders are recorded unresolved, never expanded against the host environment."
    },
    {
      "id": "kiro",
      "displayName": "Kiro",
      "vendor": "AWS",
      "priority": "P2",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "filesystem",
        "shell"
      ],
      "configPaths": [
        "<project>/.kiro/settings/mcp.json",
        "~/.kiro/settings/mcp.json"
      ],
      "scanCommands": [
        "calllint scan --agent kiro"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/kiro",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "kiro-workspace-config",
          "state": "AUDIT_REQUIRED"
        }
      ],
      "coverageBoundary": "CallLint scans MCP server entries in Kiro settings. Kiro steering files and hooks are not covered."
    },
    {
      "id": "continue",
      "displayName": "Continue",
      "vendor": "Continue",
      "priority": "P2",
      "supportClass": "DISCOVERY_ONLY",
      "authoritySurfaces": [
        "mcp",
        "tools",
        "vscode-extensions"
      ],
      "configPaths": [
        "<project>/.continue/mcpServers/*.yaml",
        "<project>/.continue/mcpServers/*.json",
        "config.yaml mcpServers block"
      ],
      "scanCommands": [],
      "canonicalUrl": "https://calllint.com/harnesses/continue",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        }
      ],
      "coverageBoundary": "CallLint does not auto-discover Continue configuration. A block file may live in .continue/mcpServers as YAML or as JSON copied from another host, so a deterministic extractor must read both shapes before this page can promise more than where the config lives."
    },
    {
      "id": "roo-code",
      "displayName": "Roo Code",
      "vendor": "Roo Code Inc",
      "priority": "P3",
      "supportClass": "DEFERRED",
      "authoritySurfaces": [
        "mcp",
        "tools",
        "vscode-extensions"
      ],
      "configPaths": [
        "Config mechanism requires verification"
      ],
      "scanCommands": [],
      "canonicalUrl": "https://calllint.com/harnesses/roo-code",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "PENDING_UPSTREAM",
          "upstream": "officialMcpRegistry"
        }
      ],
      "coverageBoundary": "CallLint does not support Roo Code discovery. Its upstream repository is archived, so config evidence was not collected: recording a config path from a possibly-discontinued product would assert a state nobody has verified."
    },
    {
      "id": "deepseek-harness",
      "displayName": "DeepSeek Harness",
      "vendor": "DeepSeek",
      "priority": "P2",
      "supportClass": "DISCOVERY_ONLY",
      "authoritySurfaces": [
        "mcp",
        "tools",
        "plugins"
      ],
      "configPaths": [
        "cordis.yml @deepseek-ai/dsh-mcp-client plugin instances"
      ],
      "scanCommands": [],
      "canonicalUrl": "https://calllint.com/harnesses/deepseek-harness",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "dsh-plugin",
          "state": "BLOCKED"
        }
      ],
      "coverageBoundary": "CallLint does not auto-discover DeepSeek Harness configuration. Its MCP servers are plugin instances in cordis.yml rather than an mcpServers map, so no existing extractor reads that shape. This record exists for discovery routing only: DeepSeek is a model vendor here, not a security-relevant distinction."
    }
  ]
}
