      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        }
      ],
      "coverageBoundary": "CallLint does not auto-discover Continue configuration. A block file may live in .continue/mcpServers as YAML or as JSON copied from another host, so a deterministic extractor must read both shapes before this page can promise more than where the config lives."
    },
    {
      "id": "roo-code",
