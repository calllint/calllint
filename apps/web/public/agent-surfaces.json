{
  "$schema": "https://calllint.com/schemas/agent-surfaces.v1.json",
  "version": "1.0.0",
  "describes": {
    "release": "1.8.0"
  },
  "description": "Machine-readable agent harness authority surfaces and CallLint support",
  "canonicalIndex": "https://calllint.com/agent-discovery-index.json",
  "mcp": {
    "registry": "io.github.calllint/calllint",
    "package": "calllint-mcp",
    "state": "LIVE"
  },
  "agents": [
    {
      "id": "claude-code",
      "displayName": "Claude Code",
      "vendor": "Anthropic",
      "priority": "P0",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "filesystem",
        "shell",
        "plugins"
      ],
      "configPaths": [
        "~/.claude/settings.json",
        "<project>/.claude/settings.json"
      ],
      "scanCommands": [
        "calllint scan --agent claude-code"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/claude-code",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AVAILABLE",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "claude-plugin",
          "state": "AUDIT_REQUIRED",
          "officialSource": "https://code.claude.com/docs/en/plugin-marketplaces"
        }
      ],
      "coverageBoundary": "CallLint scans MCP server entries only. Skills, hooks and permission settings in the same file are not covered."
    },
    {
      "id": "claude-desktop",
      "displayName": "Claude Desktop",
      "vendor": "Anthropic",
      "priority": "P0",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "mcp",
        "filesystem"
      ],
      "configPaths": [
        "~/Library/Application Support/Claude/claude_desktop_config.json",
        "%APPDATA%/Claude/claude_desktop_config.json"
      ],
      "scanCommands": [
        "calllint scan --agent claude-desktop"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/claude-desktop",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AVAILABLE",
          "upstream": "officialMcpRegistry"
        }
      ],
      "coverageBoundary": "CallLint scans MCP server entries only. Other Claude Desktop settings in the same file are not covered."
    },
    {
      "id": "cursor",
      "displayName": "Cursor",
      "vendor": "Anysphere",
