        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "openai-plugin",
          "state": "BLOCKED"
        }
      ],
      "coverageBoundary": "CallLint does not yet auto-discover Codex configuration. The config path is documented but no extractor reads TOML, so Codex servers must be passed explicitly."
    },
    {
      "id": "copilot-cli",
      "displayName": "GitHub Copilot CLI",
      "vendor": "GitHub",
      "priority": "P2",
      "supportClass": "DISCOVERY_ONLY",
      "authoritySurfaces": [
        "shell",
        "cli",
        "mcp"
      ],
      "configPaths": [
        "Config mechanism requires verification"
      ],
      "scanCommands": [],
      "canonicalUrl": "https://calllint.com/harnesses/copilot-cli",
      "distributionPrimitives": [
        {
          "kind": "mcp-registry-discovery",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "github-copilot-plugin",
          "state": "AUDIT_REQUIRED"
        }
      ],
      "coverageBoundary": "CallLint does not yet auto-discover Copilot CLI configuration."
    },
    {
      "id": "cline",
      "displayName": "Cline",
      "vendor": "Open Source",
      "priority": "P2",
      "supportClass": "NATIVE",
      "authoritySurfaces": [
        "vscode-extensions",
        "cli",
        "tools",
        "mcp"
      ],
      "configPaths": [
        "~/.cline/data/settings/cline_mcp_settings.json",
        "$CLINE_DATA_DIR/settings/cline_mcp_settings.json",
        "<appData>/Code/User/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json"
      ],
      "scanCommands": [
        "calllint scan --agent cline"
      ],
      "canonicalUrl": "https://calllint.com/harnesses/cline",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AVAILABLE",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "cline-marketplace-pr",
          "state": "PENDING_UPSTREAM"
        }
      ],
      "coverageBoundary": "CallLint auto-discovers both Cline config files: the CLI's (~/.cline/data/settings/, relocatable via CLINE_DATA_DIR) and the VS Code extension's, which lives in per-extension globalStorage and is documented by no upstream page. Neither Cline's rules, hooks, skills, agents nor plugins directories are read, and ~/Documents/Cline/MCP/ holds installed server source rather than server registrations, so it is not a config path."
    },
    {
      "id": "gemini-cli",
      "displayName": "Gemini CLI",
      "vendor": "Google",
      "priority": "P2",
      "supportClass": "DEFERRED",
      "authoritySurfaces": [
        "mcp",
        "tools"
      ],
      "configPaths": [
        "~/.gemini/config.json or similar"
      ],
      "scanCommands": [],
      "canonicalUrl": "https://calllint.com/harnesses/gemini-cli",
      "distributionPrimitives": [
        {
          "kind": "mcp-stdio",
          "state": "AUDIT_REQUIRED",
          "upstream": "officialMcpRegistry"
        },
        {
          "kind": "gemini-extension-gallery",
          "state": "AUDIT_REQUIRED",
