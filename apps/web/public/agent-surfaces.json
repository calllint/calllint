          "upstream": "officialMcpRegistry"
        }
      ],
      "coverageBoundary": "CallLint does not support Roo Code discovery. Its upstream repository is archived, so config evidence was not collected: recording a config path from a possibly-discontinued product would assert a state nobody has verified."
    },
    {
      "id": "deepseek-harness",
      "displayName": "DeepSeek Harness",
      "vendor": "DeepSeek",
      "priority": "P2",
      "supportClass": "DISCOVERY_ONLY",
      "authoritySurfaces": [
