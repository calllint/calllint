{
  "name": "calllint-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "brand:avatars": "node scripts/set-brand-avatars.mjs",
    "build": "pnpm brand:assets && pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && pnpm typecheck:functions && pnpm typecheck:worker",
    "typecheck:functions": "tsc -p apps/web/functions/tsconfig.json",
    "typecheck:worker": "tsc -p apps/usage-worker/tsconfig.json",
    "audit:evidence": "tsx scripts/audit-evidence.ts",
    "audit:coverage": "tsx scripts/coverage-audit.ts",
    "audit:coverage:write": "tsx scripts/coverage-audit.ts --write",
    "audit:calibration": "tsx scripts/calibration-audit.ts",
    "audit:calibration:write": "tsx scripts/calibration-audit.ts --write",
    "audit:calibration:gate": "tsx scripts/calibration-audit.ts --gate",
    "audit:self-claim": "tsx scripts/audit-self-claim-readiness.ts",
    "eval:phase-2.4": "tsx scripts/phase-2.4-eval.ts",
    "eval:phase-2.4:write": "tsx scripts/phase-2.4-eval.ts --write",
    "eval:phase-2.4:gate": "tsx scripts/phase-2.4-eval.ts --gate",
    "eval:phase-2.4:dogfood": "tsx scripts/phase-2.4-dogfood.ts",
    "eval:phase-2.4:dogfood:write": "tsx scripts/phase-2.4-dogfood.ts --write",
    "eval:phase-2.4:dogfood:gate": "tsx scripts/phase-2.4-dogfood.ts --gate",
    "eval:phase-2.4:gates": "tsx scripts/phase-2.4-gates.ts",
    "eval:phase-2.4:gates:write": "tsx scripts/phase-2.4-gates.ts --write",
    "eval:phase-2.4:gates:gate": "tsx scripts/phase-2.4-gates.ts --gate",
    "audit:presentation": "tsx scripts/presentation-plane-audit.ts",
    "audit:presentation:write": "tsx scripts/presentation-plane-audit.ts --write",
    "audit:presentation:gate": "tsx scripts/presentation-plane-audit.ts --gate",
    "audit:presentation:lock": "tsx scripts/presentation-lock.ts",
    "audit:presentation:lock:write": "tsx scripts/presentation-lock.ts --write",
    "audit:presentation:lock:gate": "tsx scripts/presentation-lock.ts --gate",
    "audit:preview": "tsx scripts/preview-snapshot.ts",
    "audit:preview:write": "tsx scripts/preview-snapshot.ts --write",
    "audit:preview:gate": "tsx scripts/preview-snapshot.ts --gate",
    "gate:s0": "tsx scripts/gate-s0.ts",
    "gate:s0:gate": "tsx scripts/gate-s0.ts --gate",
    "gate:s0:regression": "tsx scripts/gate-s0.ts --regression",
    "gate:s0:identity": "tsx scripts/gate-s0.ts --identity",
    "gate:s1": "tsx scripts/gate-s1.ts",
    "gate:s1:gate": "tsx scripts/gate-s1.ts --gate",
    "gate:s1:regression": "tsx scripts/gate-s1.ts --regression",
    "gate:s2": "tsx scripts/gate-s2.ts",
    "gate:s2:gate": "tsx scripts/gate-s2.ts --gate",
    "gate:s2:regression": "tsx scripts/gate-s2.ts --regression",
    "ledger:presentation:validate": "tsx scripts/presentation-ledger.ts",
    "ledger:presentation:validate:offline": "tsx scripts/presentation-ledger.ts --offline",
    "ledger:presentation:record": "tsx scripts/presentation-ledger.ts --record",
    "ledger:presentation:reseat": "tsx scripts/presentation-ledger.ts --reseat",
    "eval:phase-2.4:panel": "tsx scripts/phase-2.4-panel.ts",
    "eval:phase-2.4:panel:validate": "tsx scripts/phase-2.4-panel.ts --validate",
    "eval:phase-2.4:panel:record": "tsx scripts/phase-2.4-panel.ts --record",
    "eval:phase-2.4:panel:reseat": "tsx scripts/phase-2.4-panel.ts --reseat",
    "smoke": "pnpm build && vitest run tests/e2e/test/package-smoke.test.ts",
    "pack:smoke": "node scripts/package-smoke.mjs",
    "pack:smoke:mcp": "node scripts/mcp-pack-smoke.mjs",
    "corpus:test": "node scripts/run-corpus.mjs",
    "corpus:test:verbose": "node scripts/run-corpus.mjs --verbose",
    "corpus:test:case": "node scripts/run-corpus.mjs --case",
    "corpus:test:r2-final": "node scripts/run-corpus.mjs --r2-final",
    "bench:test": "node scripts/run-bench.mjs",
    "bench:test:verbose": "node scripts/run-bench.mjs --verbose",
    "bench:fixtures": "vitest run packages/resolver/test/evidence/benchmark.test.ts",
    "schema:compat": "vitest run tests/schema/schema-compatibility.test.ts packages/evidence/test/model-schema.test.ts packages/telemetry-contract/test/schema.test.ts packages/report-renderer/test/sarif-schema.test.ts tests/readback/manifestSchema.test.ts",
    "agent:smoke": "vitest run apps/cli/test/integrate.test.ts tests/e2e/test/apply-engine.e2e.test.ts tests/e2e/test/auto-discovery.e2e.test.ts tests/invariants/preflight-hook-non-blocking.invariants.test.ts",
    "check:public-copy": "node scripts/check-public-copy.mjs",
    "check:web-structure": "node scripts/check-web-structure.mjs",
    "check:harness-distribution": "node scripts/check-harness-distribution.mjs",
    "check:agent-surface": "node scripts/check-agent-surface-contract.mjs",
    "check:security-semantics": "node scripts/verify-security-semantic-diff.mjs --check",
    "write:security-semantics": "node scripts/verify-security-semantic-diff.mjs",
    "check:registry-presence": "node scripts/verify-registry-presence.mjs",
    "check:release-ancestry": "node scripts/verify-release-ancestry.mjs",
    "check:mcp-tag-protection": "node scripts/verify-mcp-tag-protection.mjs",
    "gen:distribution": "node scripts/generate-distribution-surfaces.mjs",
    "check:distribution-drift": "node scripts/generate-distribution-surfaces.mjs --check",
    "check:published-schema": "node scripts/check-published-schema-contract.mjs",
    "facts:check": "node scripts/derive-facts.mjs",
    "facts:write": "node scripts/derive-facts.mjs --write",
    "check:telemetry-boundary": "node scripts/check-telemetry-boundary.mjs",
    "usage:report": "tsx scripts/generate-usage-report.mjs",
    "usage:report:offline": "tsx scripts/generate-usage-report.mjs --offline",
    "bake:trust-index": "pnpm --filter @calllint/trust-index bake",
    "ingest:trust-index": "pnpm --filter @calllint/trust-index ingest",
    "prune:cas": "pnpm --filter @calllint/trust-index prune-cas",
    "recover-checkpoint:trust-index": "pnpm --filter @calllint/trust-index recover-checkpoint",
    "backup:adoption-index": "pnpm --filter @calllint/trust-index backup-adoption-index",
    "backup:adoption-index:prune-staging": "pnpm --filter @calllint/trust-index backup-adoption-index:prune-staging",
    "restore:adoption-index": "pnpm --filter @calllint/trust-index restore-adoption-index",
    "resolve-evidence:trust-index": "pnpm --filter @calllint/trust-index resolve-evidence",
    "project-adoption-index:trust-index": "pnpm --filter @calllint/trust-index project-adoption-index",
    "project-adoption-index:trust-index:store": "pnpm --filter @calllint/trust-index project-adoption-index:store",
    "verify-claims:trust-index": "pnpm --filter @calllint/trust-index verify-claims",
    "sync:mcp-bundle": "node scripts/sync-mcp-bundle.mjs",
    "sync:mcp-bundle:check": "node scripts/sync-mcp-bundle.mjs --check",
    "ci:local": "pnpm typecheck && pnpm test && pnpm build && pnpm corpus:test && pnpm bench:test && pnpm check:public-copy && pnpm check:web-structure && pnpm check:published-schema && pnpm check:distribution-drift && pnpm check:harness-distribution && pnpm check:agent-surface && pnpm check:security-semantics && pnpm audit:evidence && pnpm audit:coverage && pnpm audit:calibration && pnpm eval:phase-2.4 && pnpm eval:phase-2.4:dogfood && pnpm eval:phase-2.4:gates && pnpm eval:phase-2.4:panel:validate && pnpm audit:presentation && pnpm audit:presentation:gate && pnpm audit:presentation:lock && pnpm audit:presentation:lock:gate && pnpm audit:preview && pnpm audit:preview:gate && pnpm ledger:presentation:validate && pnpm gate:s0:regression && pnpm gate:s1:regression"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@types/node": "^20.14.0",
    "ajv": "^8.12.0",
    "handlebars": "^4.7.9",
    "sharp": "^0.35.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "yaml": "2.8.2"
  }
}
