{
  "name": "Protect mcp-v* release tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["refs/tags/mcp-v*"],
      "exclude": []
    }
  },
  "rules": [{ "type": "creation" }, { "type": "deletion" }],
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ]
}
